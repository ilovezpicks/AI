
import streamlit as st
import requests

API_BASE = "https://api.prop-line.com/v1"

@st.cache_data(ttl=300, show_spinner=False)
def get_nba_prop_odds():
    """Fetch current NBA player prop odds."""
    api_key = st.secrets.get("PROPLINE_API_KEY")

    if not api_key:
        raise ValueError("PropLine API key is missing.")

    markets = [
        "player_points",
        "player_rebounds",
        "player_assists",
        "player_threes",
        "player_steals",
        "player_blocks",
        "player_points_rebounds_assists",
    ]

    response = requests.get(
        f"{API_BASE}/sports/basketball_nba/odds",
        headers={"X-API-Key": api_key},
        params={"markets": ",".join(markets)},
        timeout=20,
    )
    response.raise_for_status()
    return response.json()
